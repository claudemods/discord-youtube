{
  "name": "discord-youtube",
  "productName": "discord-youtube",
  "version": "1.0-0-15-09-2026",
  "description": "discord-youtube",
  "main": "src/index.js",
  "scripts": {
    "start": "electron .",
    "macbuild": "electron-builder -m",
    "linbuild": "electron-builder -l",
    "winbuild": "electron-builder -w",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudemods/discord-youTube.git"
  },
  "author": "claudemods",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/claudemods/discord-youTube/issues"
  },
  "build": {
    "appId": "discordyouTube",
    "win": {
      "target": "nsis",
      "icon": "./assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "./assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "./assets/icon.png"
    },
    "artifactName": "${productName}_Setup_${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "homepage": "https://github.com/claudemods/discord-youTube#readme",
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "axios": "^1.15.2",
    "discord-api-types": "^0.38.55",
    "electron-discord-register": "1.0.0",
    "jquery": "^3.7.1",
    "moment": "2.30.1",
    "node-fetch": "^2.7.0",
    "setimmediate": "^1.0.5",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "all-contributors-cli": "^6.26.1",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3"
  }
}
